    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^16.5.0",
    "playwright": "^1.58.2",
    "publint": "^0.3.24",
    "react": "19.2.3",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
