{
  "name": "rift-ds",
  "private": true,
  "version": "1.27.0",
  "description": "An AI-ready React design system: accessible components on composable tokens, light/dark theming, and CSS-variable overrides.",
  "author": {
    "name": "Robert Ritacca",
    "url": "https://robertritacca.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robritacca-dotcom/rift-ds.git"
  },
  "homepage": "https://rift-ds.com",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11.5.1"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "workspaces": [
    "website"
  ],
  "$comment-overrides": "Pins that outrank the ranges next declares for two of its transitive deps: postcss (next pins an exact 8.5.x, 8.5.23 as of next 16.3.4, and the override takes the patched newer 8.5 line) and sharp (next's optional image optimiser; the root devDependency copy exists only so the whole tree dedupes onto one pinned build of it, no repo code imports sharp directly). As of next 16.3.8, next declares sharp at ^0.35.4, which already covers the installed build, so the sharp pin is redundant and can retire; postcss is still pinned exactly by next (8.5.23), so its override still does work. `npm ls` flags the postcss copy as invalid against next's exact pin, which is the override working and not a fault (one copy in the tree, on the patched line); `npm audit` is the real test, and the postcss pin can retire when next's declared range catches up. npm ONLY honours overrides in the workspace ROOT, the copies that used to live in website/package.json were silently ignored after the workspaces conversion, which un-pinned both. Keep them here.",
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.3",
    "texture-compressor": {
      "image-size": "^2.1.0"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./charts": "./src/charts.ts",
    "./components/registry": "./src/components/registry.ts",
    "./components/Avatar/demoAvatars": "./src/components/Avatar/demoAvatars.ts",
    "./components/Attachment/fileTypes": "./src/components/Attachment/fileTypes.ts",
    "./components/Mention/mentions": "./src/components/Mention/mentions.ts",
    "./components/Attachment/useAttachments": "./src/components/Attachment/useAttachments.ts",
    "./components/ShaderField/useShaderField": "./src/components/ShaderField/useShaderField.ts",
    "./components/StreamingText/useStreamReveal": "./src/components/StreamingText/useStreamReveal.ts",
    "./behaviors/useScrollLock": "./src/behaviors/useScrollLock.ts",
    "./behaviors/LinkProvider": "./src/behaviors/LinkProvider.tsx",
    "./behaviors/LocaleProvider": "./src/behaviors/LocaleProvider.tsx",
    "./behaviors/shortcuts": "./src/behaviors/shortcuts.ts",
    "./chat": "./src/chat/index.ts",
    "./chat/server": "./src/chat/server.ts",
    "./chat/actions": "./src/chat/actions.ts",
    "./chat/upstash": "./src/chat/upstash.ts",
    "./chat/demo": "./src/chat/demo.ts",
    "./chat/chat.css": "./src/chat/ChatWidget.css",
    "./format": "./src/format/index.ts",
    "./tokens/registry": "./src/tokens/registry.ts",
    "./tokens/values": "./src/tokens/values.ts",
    "./tokens/motion": "./src/tokens/motion.ts",
    "./tokens/breakpoints": "./src/tokens/breakpoints.ts",
    "./components/*": "./src/components/*.tsx",
    "./tokens/*.css": "./src/tokens/*.css",
    "./tokens/presets/*.css": "./src/tokens/presets/*.css",
    "./fonts/*": "./src/fonts/*",
    "./package.json": "./package.json",
    "./components/DatePicker/MonthGrid": null,
    "./components/Widget/WidgetDisclosure": null,
    "./components/DescriptionList/DescriptionListCopy": null
  },
  "scripts": {
    "validate-registry": "node scripts/run-chain.mjs",
    "prebuild": "npm run validate-registry",
    "graph": "node scripts/generate-dependency-graph.mjs",
    "registry-downloads": "node scripts/registry-downloads.mjs",
    "build": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run build && node scripts/validate-api-compat.mjs && npm run build:lib && node scripts/validate-package-publish.mjs && npm run test && npm run build-storybook && npm --prefix website run lint && npm --prefix website run build && node scripts/validate-rendered-spacing.mjs && node scripts/validate-corpus-coverage.mjs && node scripts/validate-internal-links.mjs && node scripts/smoke-hydration.mjs && node scripts/validate-gestures.mjs && node scripts/validate-website-a11y.mjs",
    "verify:labs": "node scripts/labs-only-change.mjs --check && npm run lint && npm run build && npm --prefix website run lint && npm --prefix website run build && node scripts/validate-rendered-spacing.mjs && node scripts/validate-corpus-coverage.mjs && node scripts/validate-internal-links.mjs && node scripts/smoke-hydration.mjs",
    "eval:chat": "npx -y promptfoo@0.122.0 eval -c evals/chat/promptfooconfig.yaml --no-cache --output evals/chat/runs/latest.json",
    "eval:starters": "npx -y promptfoo@0.122.0 eval -c evals/chat-starters/promptfooconfig.yaml --no-cache --output evals/chat-starters/runs/latest.json",
    "eval:merchant": "npx -y promptfoo@0.122.0 eval -c evals/merchant-chat/promptfooconfig.yaml --no-cache --output evals/merchant-chat/runs/latest.json",
    "prestorybook": "npm run validate-registry",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run validate-registry",
    "build-storybook": "storybook build",
    "build:lib": "node scripts/build-package.mjs"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.0.0",
    "remark-gfm": "^4.0.1"
  },
