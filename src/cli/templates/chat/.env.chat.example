# The chat widget's environment. Copy what you need into .env.local.

# Demo mode: the widget plays a scripted conversation in the browser, with
# no model, route or key. Set to false (or remove) to go live.
NEXT_PUBLIC_CHAT_DEMO=true

# Live mode. Both must be set for the routes to call a model; until then they
# answer with a polite notice.
CHAT_ENABLED=false
ANTHROPIC_API_KEY=

# Guardrails over Upstash Redis (optional). Unset, every request is allowed
# and nothing is logged. Set all three to get per-visitor rate limits, a
# daily budget with model tiers, the exchange log and the feedback store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
CHAT_VISITOR_SALT=

# The daily breaker, in messages and US cents (defaults shown).
CHAT_DAILY_MESSAGE_CAP=300
CHAT_DAILY_SPEND_CAP_CENTS=500
