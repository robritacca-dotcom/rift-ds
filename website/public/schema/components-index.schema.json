{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rift-ds component schema index",
  "description": "The file at /schema/components.json: one row per published component schema, in registry order with the chat widget last. Generated by scripts/generate-component-schema.mjs; the count is the array's length, the chat widget included, so it is one more than the component count, and it is never typed by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "package", "count", "components"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "package": { "type": "string", "minLength": 1 },
    "count": { "type": "integer", "minimum": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "label", "slug", "category", "kind", "schemaUrl", "docsUrl", "markdownUrl"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
          "label": { "type": "string", "minLength": 1 },
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "category": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["component", "widget"] },
          "schemaUrl": { "type": "string", "format": "uri" },
          "docsUrl": { "type": "string", "format": "uri" },
          "markdownUrl": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
