{
  "$schema": "https://rift-ds.com/schema/component.schema.json",
  "version": "1.40.0",
  "kind": "component",
  "name": "ContextMenu",
  "label": "Context menu",
  "slug": "context-menu",
  "category": "overlays",
  "description": "Right-click menu at the pointer with groups, sub-menus, and shortcut hints.",
  "client": true,
  "importPath": "rift-ds/components/ContextMenu/ContextMenu",
  "barrel": "main",
  "docsUrl": "https://rift-ds.com/components/context-menu",
  "markdownUrl": "https://rift-ds.com/components/context-menu.md",
  "exports": [
    {
      "component": "ContextMenu",
      "props": [
        {
          "name": "items",
          "type": "DropdownMenuEntry[]",
          "typeKind": "array",
          "required": true,
          "description": "Menu entries — DropdownMenu's model (items, groups, separators). A context menu draws an item's label, icon, shortcut, selected and destructive states; it does not draw `description` or `checked`, and `closeOnSelect` is not read.",
          "typeRefs": [
            "DropdownMenuEntry"
          ]
        },
        {
          "name": "size",
          "type": "\"default\" | \"compact\"",
          "typeKind": "enum",
          "values": [
            "compact",
            "default"
          ],
          "required": false,
          "description": "Component size",
          "default": "default"
        },
        {
          "name": "ariaLabel",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Legacy accessible-name prop for the menu. A native `aria-label` wins when both are passed, and names the menu rather than the wrapper.",
          "deprecated": "Pass the native `aria-label` attribute instead."
        },
        {
          "name": "keyLabels",
          "type": "Partial<Record<string, string>>",
          "typeKind": "reference",
          "required": false,
          "description": "Replaces any legend an item's `keys` is written with, such as `{ ctrl: 'Strg' }` for a German keyboard.",
          "typeRefs": [
            "ShortcutKeyLabels"
          ]
        },
        {
          "name": "className",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Additional CSS classes",
          "default": ""
        },
        {
          "name": "children",
          "type": "ReactNode",
          "typeKind": "reference",
          "required": true,
          "description": "The right-clickable area the menu is attached to"
        }
      ]
    }
  ],
  "types": {
    "DropdownMenuEntry": {
      "kind": "type",
      "definition": "type DropdownMenuEntry =\n  | DropdownMenuItem\n  | DropdownMenuSeparator\n  | DropdownMenuGroup;",
      "refs": [
        "DropdownMenuGroup",
        "DropdownMenuItem",
        "DropdownMenuSeparator"
      ]
    },
    "DropdownMenuGroup": {
      "kind": "component-props",
      "component": "DropdownMenu",
      "see": "get_component(\"DropdownMenu\")"
    },
    "DropdownMenuItem": {
      "kind": "component-props",
      "component": "DropdownMenu",
      "see": "get_component(\"DropdownMenu\")"
    },
    "DropdownMenuSeparator": {
      "kind": "component-props",
      "component": "DropdownMenu",
      "see": "get_component(\"DropdownMenu\")"
    },
    "ShortcutKeyLabels": {
      "kind": "type",
      "definition": "type ShortcutKeyLabels = Partial<Record<string, string>>;",
      "description": "The legends a shortcut is drawn with, by modifier or key name. Merged over the platform's defaults."
    }
  },
  "externalTypes": {
    "Partial": "typescript",
    "ReactNode": "react",
    "Record": "typescript"
  },
  "keyboard": [
    {
      "pattern": "menu",
      "label": "Menu",
      "apg": "https://www.w3.org/WAI/ARIA/apg/patterns/menubar/",
      "rows": [
        {
          "keys": [],
          "when": "On open",
          "text": "Opening the menu moves focus into it."
        },
        {
          "keys": [
            "ArrowDown"
          ],
          "text": "Moves to the next item."
        },
        {
          "keys": [
            "ArrowUp"
          ],
          "text": "Moves to the previous item."
        },
        {
          "keys": [
            "End"
          ],
          "text": "Moves to the last item."
        },
        {
          "keys": [
            "Home"
          ],
          "text": "Moves to the first item."
        },
        {
          "keys": [],
          "when": "A letter",
          "text": "Moves to the next item whose name starts with it."
        },
        {
          "keys": [
            "Escape"
          ],
          "text": "Closes the menu and returns focus to what opened it."
        }
      ]
    }
  ],
  "size": {
    "gzip": 7860
  },
  "alternatives": [
    {
      "name": "DropdownMenu",
      "when": "the menu opens from a visible trigger",
      "schemaUrl": "https://rift-ds.com/schema/components/dropdown-menu.json"
    }
  ]
}
