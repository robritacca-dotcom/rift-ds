{
  "$schema": "https://rift-ds.com/schema/component.schema.json",
  "version": "1.35.0",
  "kind": "component",
  "name": "ProgressBar",
  "label": "Progress bar",
  "slug": "progress-bar",
  "category": "feedback",
  "description": "Horizontal bar indicating completion progress, with an optional percentage label.",
  "client": false,
  "importPath": "rift-ds/components/ProgressBar/ProgressBar",
  "barrel": "main",
  "docsUrl": "https://rift-ds.com/components/progress-bar",
  "markdownUrl": "https://rift-ds.com/components/progress-bar.md",
  "exports": [
    {
      "component": "ProgressBar",
      "props": [
        {
          "name": "value",
          "type": "number",
          "typeKind": "primitive",
          "required": false,
          "description": "Current progress value (0–100)",
          "default": 0
        },
        {
          "name": "size",
          "type": "\"default\" | \"compact\"",
          "typeKind": "enum",
          "values": [
            "compact",
            "default"
          ],
          "required": false,
          "description": "Size of the bar",
          "default": "default"
        },
        {
          "name": "showLabel",
          "type": "boolean",
          "typeKind": "primitive",
          "required": false,
          "description": "Show percentage label",
          "default": false
        },
        {
          "name": "ariaLabel",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Legacy accessible-name prop for the bar, saying what is loading. A native `aria-label` wins when both are passed; with neither, the bar is named \"Progress\".",
          "deprecated": "Pass the native `aria-label` attribute instead."
        },
        {
          "name": "locale",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "The BCP 47 locale the percentage label is written in, such as `ar-EG`. Defaults to `en-US`. This component can render from a Server Component, so it takes the prop alone and reads no LocaleProvider.",
          "default": "en-US"
        },
        {
          "name": "className",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Additional CSS classes",
          "default": ""
        }
      ]
    }
  ],
  "keys": {
    "by": "none"
  },
  "size": {
    "gzip": 715
  },
  "alternatives": [
    {
      "name": "Spinner",
      "when": "the wait is indeterminate",
      "schemaUrl": "https://rift-ds.com/schema/components/spinner.json"
    }
  ]
}
