{
  "$schema": "https://rift-ds.com/schema/component.schema.json",
  "version": "1.27.0",
  "kind": "component",
  "name": "RichDropdown",
  "label": "Rich dropdown",
  "slug": "rich-dropdown",
  "category": "forms",
  "description": "Dropdown's rich sibling: options preview their own heading face, body face, and key colour.",
  "client": true,
  "importPath": "rift-ds/components/RichDropdown/RichDropdown",
  "barrel": "main",
  "docsUrl": "https://rift-ds.com/components/rich-dropdown",
  "markdownUrl": "https://rift-ds.com/components/rich-dropdown.md",
  "exports": [
    {
      "component": "RichDropdown",
      "props": [
        {
          "name": "label",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Field label text"
        },
        {
          "name": "placeholder",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Placeholder when no value selected",
          "default": "Select an option"
        },
        {
          "name": "value",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Selected option value for controlled use. Pair with `onValueChange`."
        },
        {
          "name": "defaultValue",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Initially selected option value for uncontrolled use."
        },
        {
          "name": "options",
          "type": "RichDropdownOption[]",
          "typeKind": "array",
          "required": true,
          "description": "The options on offer, in display order."
        },
        {
          "name": "disabled",
          "type": "boolean",
          "typeKind": "primitive",
          "required": false,
          "description": "Whether the picker is disabled",
          "default": false
        },
        {
          "name": "required",
          "type": "boolean",
          "typeKind": "primitive",
          "required": false,
          "description": "Whether the picker is required",
          "default": false
        },
        {
          "name": "error",
          "type": "boolean",
          "typeKind": "primitive",
          "required": false,
          "description": "Error state",
          "default": false
        },
        {
          "name": "helperText",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Helper or error message"
        },
        {
          "name": "onValueChange",
          "type": "((value: string) => void)",
          "typeKind": "function",
          "required": false,
          "description": "Fires with the newly selected option's value."
        },
        {
          "name": "className",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Additional CSS classes",
          "default": ""
        },
        {
          "name": "name",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Form field name. When set, the selected option's `value` submits with an\nenclosing form through a hidden input (nothing while no value is set,\nnothing while disabled), as Combobox does. Also the fallback for the\nelement id (`id || name || label`)."
        }
      ]
    }
  ]
}
