{
  "$schema": "https://rift-ds.com/schema/component.schema.json",
  "version": "1.19.1",
  "kind": "component",
  "name": "ScatterChart",
  "label": "Scatter chart",
  "slug": "scatter-chart",
  "category": "charts",
  "description": "Plots point clusters across two axes to show correlation and distribution.",
  "client": true,
  "importPath": "rift-ds/components/Chart/ScatterChart",
  "barrel": "charts",
  "docsUrl": "https://rift-ds.com/components/scatter-chart",
  "markdownUrl": "https://rift-ds.com/components/scatter-chart.md",
  "exports": [
    {
      "component": "ScatterChart",
      "props": [
        {
          "name": "locale",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "The BCP 47 locale the values, tooltips and value axis are written in, such as `de-DE`. Defaults to the nearest LocaleProvider's, else `en-US`."
        },
        {
          "name": "datasets",
          "type": "ScatterDatasetConfig[]",
          "typeKind": "array",
          "required": true,
          "description": "One or more scatter datasets to plot"
        },
        {
          "name": "xKey",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Key in data for x-axis values",
          "default": "x"
        },
        {
          "name": "yKey",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Key in data for y-axis values",
          "default": "y"
        },
        {
          "name": "xLabel",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Display label for x-axis",
          "default": "X"
        },
        {
          "name": "yLabel",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Display label for y-axis",
          "default": "Y"
        },
        {
          "name": "title",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Chart title, in the shared chart header; it also names the figure.\nNote: this replaces the native `title` tooltip attribute, which the chart does not expose."
        },
        {
          "name": "subtitle",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Description text below the title"
        },
        {
          "name": "summaryItems",
          "type": "ChartSummaryItem[]",
          "typeKind": "array",
          "required": false,
          "description": "Summary stats displayed in the header"
        },
        {
          "name": "height",
          "type": "number",
          "typeKind": "primitive",
          "required": false,
          "description": "Chart area height in pixels",
          "default": 350
        },
        {
          "name": "bare",
          "type": "boolean",
          "typeKind": "primitive",
          "required": false,
          "description": "Strip the card chrome (border, padding, fill) when the chart sits inside another panel that supplies the surface",
          "default": false
        },
        {
          "name": "className",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Additional CSS classes on the wrapper",
          "default": ""
        }
      ]
    }
  ]
}
