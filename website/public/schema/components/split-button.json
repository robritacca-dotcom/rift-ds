{
  "$schema": "https://rift-ds.com/schema/component.schema.json",
  "version": "1.40.0",
  "kind": "component",
  "name": "SplitButton",
  "label": "Split button",
  "slug": "split-button",
  "category": "actions",
  "description": "Primary action with an attached menu of alternatives, composing Button and DropdownMenu in one pill, in primary or secondary emphasis and any tone.",
  "client": false,
  "importPath": "rift-ds/components/SplitButton/SplitButton",
  "barrel": "main",
  "docsUrl": "https://rift-ds.com/components/split-button",
  "markdownUrl": "https://rift-ds.com/components/split-button.md",
  "exports": [
    {
      "component": "SplitButton",
      "props": [
        {
          "name": "label",
          "type": "string",
          "typeKind": "primitive",
          "required": true,
          "description": "Label of the primary action"
        },
        {
          "name": "onClick",
          "type": "MouseEventHandler<HTMLButtonElement>",
          "typeKind": "function",
          "required": false,
          "description": "Click handler for the primary action"
        },
        {
          "name": "type",
          "type": "\"button\" | \"submit\" | \"reset\"",
          "typeKind": "enum",
          "values": [
            "button",
            "reset",
            "submit"
          ],
          "required": false,
          "description": "The primary segment's native type. Defaults to `button`; set `submit` to\nmake the primary action its form's submit button. The menu trigger is\nalways `button`, so opening the menu never submits.",
          "default": "button"
        },
        {
          "name": "items",
          "type": "DropdownMenuEntry[]",
          "typeKind": "array",
          "required": true,
          "description": "Menu entries for the alternative actions",
          "typeRefs": [
            "DropdownMenuEntry"
          ]
        },
        {
          "name": "variant",
          "type": "\"neutral\" | \"primary\" | \"secondary\"",
          "typeKind": "enum",
          "values": [
            "neutral",
            "primary",
            "secondary"
          ],
          "required": false,
          "description": "Emphasis, shared by both segments: `primary` (filled) or `secondary`\n(outlined). The colour is `tone`'s job. `neutral` is the legacy value\nfrom before the split and renders as `variant=\"primary\" tone=\"neutral\"`.",
          "default": "primary"
        },
        {
          "name": "tone",
          "type": "\"default\" | \"destructive\" | \"neutral\"",
          "typeKind": "enum",
          "values": [
            "default",
            "destructive",
            "neutral"
          ],
          "required": false,
          "description": "Colour, shared by both segments: `default` carries the action colour,\n`neutral` the greys, `destructive` the danger colour."
        },
        {
          "name": "size",
          "type": "\"default\" | \"compact\"",
          "typeKind": "enum",
          "values": [
            "compact",
            "default"
          ],
          "required": false,
          "description": "Component size",
          "default": "default"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "typeKind": "primitive",
          "required": false,
          "description": "Disables both segments",
          "default": false
        },
        {
          "name": "loading",
          "type": "boolean",
          "typeKind": "primitive",
          "required": false,
          "description": "Shows a spinner on the primary segment and blocks interaction while an async action runs",
          "default": false
        },
        {
          "name": "iconLeft",
          "type": "string | ReactNode",
          "typeKind": "other",
          "required": false,
          "description": "Icon for the primary segment — Material Symbol name or custom element"
        },
        {
          "name": "align",
          "type": "\"start\" | \"end\"",
          "typeKind": "enum",
          "values": [
            "end",
            "start"
          ],
          "required": false,
          "description": "Horizontal alignment of the menu panel relative to the control",
          "default": "end"
        },
        {
          "name": "menuLabel",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Accessible name of the menu trigger segment",
          "default": "More actions"
        },
        {
          "name": "className",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Additional CSS classes, applied to the wrapper around both segments, not the primary button",
          "default": ""
        }
      ]
    }
  ],
  "types": {
    "DropdownMenuEntry": {
      "kind": "type",
      "definition": "type DropdownMenuEntry =\n  | DropdownMenuItem\n  | DropdownMenuSeparator\n  | DropdownMenuGroup;",
      "refs": [
        "DropdownMenuGroup",
        "DropdownMenuItem",
        "DropdownMenuSeparator"
      ]
    },
    "DropdownMenuGroup": {
      "kind": "component-props",
      "component": "DropdownMenu",
      "see": "get_component(\"DropdownMenu\")"
    },
    "DropdownMenuItem": {
      "kind": "component-props",
      "component": "DropdownMenu",
      "see": "get_component(\"DropdownMenu\")"
    },
    "DropdownMenuSeparator": {
      "kind": "component-props",
      "component": "DropdownMenu",
      "see": "get_component(\"DropdownMenu\")"
    }
  },
  "externalTypes": {
    "HTMLButtonElement": "typescript",
    "MouseEventHandler": "react",
    "ReactNode": "react"
  },
  "keyboard": [
    {
      "pattern": "button",
      "part": "main button",
      "label": "Button",
      "apg": "https://www.w3.org/WAI/ARIA/apg/patterns/button/",
      "rows": [
        {
          "keys": [
            "Enter"
          ],
          "text": "Activates the button."
        },
        {
          "keys": [
            "Space"
          ],
          "text": "Activates the button."
        }
      ]
    },
    {
      "pattern": "menu",
      "part": "menu of other actions",
      "label": "Menu",
      "apg": "https://www.w3.org/WAI/ARIA/apg/patterns/menubar/",
      "rows": [
        {
          "keys": [],
          "when": "On open",
          "text": "Opening the menu moves focus into it."
        },
        {
          "keys": [
            "ArrowDown"
          ],
          "text": "Moves to the next item."
        },
        {
          "keys": [
            "ArrowUp"
          ],
          "text": "Moves to the previous item."
        },
        {
          "keys": [
            "End"
          ],
          "text": "Moves to the last item."
        },
        {
          "keys": [
            "Home"
          ],
          "text": "Moves to the first item."
        },
        {
          "keys": [],
          "when": "A letter",
          "text": "Moves to the next item whose name starts with it."
        },
        {
          "keys": [
            "Escape"
          ],
          "text": "Closes the menu and returns focus to what opened it."
        }
      ]
    }
  ],
  "size": {
    "gzip": 11964
  }
}
