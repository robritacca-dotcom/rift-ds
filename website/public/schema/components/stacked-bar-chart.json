{
  "$schema": "https://rift-ds.com/schema/component.schema.json",
  "version": "1.20.0",
  "kind": "component",
  "name": "StackedBarChart",
  "label": "Stacked bar chart",
  "slug": "stacked-bar-chart",
  "category": "charts",
  "description": "Bars split into stacked segments to compare totals and their composition.",
  "client": true,
  "importPath": "rift-ds/components/Chart/StackedBarChart",
  "barrel": "charts",
  "docsUrl": "https://rift-ds.com/components/stacked-bar-chart",
  "markdownUrl": "https://rift-ds.com/components/stacked-bar-chart.md",
  "exports": [
    {
      "component": "StackedBarChart",
      "props": [
        {
          "name": "locale",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "The BCP 47 locale the values, tooltips and value axis are written in, such as `de-DE`. Defaults to the nearest LocaleProvider's, else `en-US`."
        },
        {
          "name": "data",
          "type": "Record<string, unknown>[]",
          "typeKind": "array",
          "required": true,
          "description": "Array of data objects"
        },
        {
          "name": "xKey",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Key in data for x-axis values",
          "default": "label"
        },
        {
          "name": "series",
          "type": "BarSeriesConfig[]",
          "typeKind": "array",
          "required": true,
          "description": "One or more bar series to render (stacked)"
        },
        {
          "name": "title",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Chart title, in the shared chart header; it also names the figure.\nNote: this replaces the native `title` tooltip attribute, which the chart does not expose."
        },
        {
          "name": "subtitle",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Description text below the title"
        },
        {
          "name": "summaryItems",
          "type": "ChartSummaryItem[]",
          "typeKind": "array",
          "required": false,
          "description": "Summary stats displayed in the header"
        },
        {
          "name": "height",
          "type": "number",
          "typeKind": "primitive",
          "required": false,
          "description": "Chart area height in pixels",
          "default": 350
        },
        {
          "name": "yAxisFormatter",
          "type": "((value: number) => string)",
          "typeKind": "function",
          "required": false,
          "description": "Y-axis tick formatter"
        },
        {
          "name": "bare",
          "type": "boolean",
          "typeKind": "primitive",
          "required": false,
          "description": "Strip the card chrome (border, padding, fill) when the chart sits inside another panel that supplies the surface",
          "default": false
        },
        {
          "name": "className",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Additional CSS classes on the wrapper",
          "default": ""
        }
      ]
    }
  ]
}
