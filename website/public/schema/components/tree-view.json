{
  "$schema": "https://rift-ds.com/schema/component.schema.json",
  "version": "1.33.0",
  "kind": "component",
  "name": "TreeView",
  "label": "Tree view",
  "slug": "tree-view",
  "category": "data-display",
  "description": "Collapsible hierarchy for files, folders, and nested structures.",
  "client": true,
  "importPath": "rift-ds/components/TreeView/TreeView",
  "barrel": "main",
  "docsUrl": "https://rift-ds.com/components/tree-view",
  "markdownUrl": "https://rift-ds.com/components/tree-view.md",
  "exports": [
    {
      "component": "TreeView",
      "props": [
        {
          "name": "nodes",
          "type": "TreeViewNode[]",
          "typeKind": "array",
          "required": true,
          "description": "Tree data to render",
          "typeRefs": [
            "TreeViewNode"
          ]
        },
        {
          "name": "defaultExpandedIds",
          "type": "string[]",
          "typeKind": "array",
          "required": false,
          "description": "IDs of initially expanded branches (uncontrolled)",
          "defaultExpression": "[]"
        },
        {
          "name": "expandedIds",
          "type": "string[]",
          "typeKind": "array",
          "required": false,
          "description": "Expanded branch IDs (controlled) — pair with `onExpandedChange`"
        },
        {
          "name": "onExpandedChange",
          "type": "((ids: string[]) => void)",
          "typeKind": "function",
          "required": false,
          "description": "Called with the full list of expanded branch IDs whenever a branch toggles"
        },
        {
          "name": "selectedId",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Selected node ID (controlled) — pair with `onSelect`"
        },
        {
          "name": "defaultSelectedId",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "ID of the initially selected node (uncontrolled)"
        },
        {
          "name": "onSelect",
          "type": "((id: string) => void)",
          "typeKind": "function",
          "required": false,
          "description": "Called with the node's ID when a row is selected via click, Enter, or\nSpace. Intentionally shadows the native `select` event handler, which\nhas no meaning on a tree widget."
        },
        {
          "name": "className",
          "type": "string",
          "typeKind": "primitive",
          "required": false,
          "description": "Additional CSS classes",
          "default": ""
        }
      ]
    }
  ],
  "types": {
    "TreeViewNode": {
      "kind": "interface",
      "definition": "interface TreeViewNode {\n  /** Unique identifier for the node */\n  id: string;\n  /** Text shown on the row */\n  label: string;\n  /** Icon on the row — Material Symbol name (string) or custom element (ReactNode); defaults to `folder` for branches and `draft` for leaves */\n  icon?: string | React.ReactNode;\n  /** Child nodes; a non-empty list makes the node an expandable branch */\n  children?: TreeViewNode[];\n}"
    }
  },
  "externalTypes": {
    "ReactNode": "react"
  },
  "keyboard": [
    {
      "pattern": "tree",
      "label": "Tree view",
      "apg": "https://www.w3.org/WAI/ARIA/apg/patterns/treeview/",
      "rows": [
        {
          "keys": [
            "ArrowDown"
          ],
          "text": "Moves to the next visible row."
        },
        {
          "keys": [
            "ArrowUp"
          ],
          "text": "Moves to the previous visible row."
        },
        {
          "keys": [
            "End"
          ],
          "text": "Moves to the last visible row."
        },
        {
          "keys": [
            "Home"
          ],
          "text": "Moves to the first row."
        },
        {
          "keys": [
            "ArrowRight"
          ],
          "text": "Opens a closed branch.",
          "inline": true
        },
        {
          "keys": [
            "ArrowLeft"
          ],
          "text": "Closes an open branch.",
          "inline": true
        },
        {
          "keys": [],
          "when": "A letter",
          "text": "Moves to the next visible row whose name starts with it."
        }
      ]
    }
  ],
  "size": {
    "gzip": 2033
  },
  "alternatives": [
    {
      "name": "OrgChart",
      "when": "the hierarchy is people, drawn as a chart of who reports to whom",
      "schemaUrl": "https://rift-ds.com/schema/components/org-chart.json"
    }
  ]
}
